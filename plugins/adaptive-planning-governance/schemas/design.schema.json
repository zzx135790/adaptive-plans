{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaptive-planning-governance/design.schema.json",
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "behavior_budget": {
      "type": "object",
      "required": ["required", "excluded", "deferred_candidates"],
      "properties": {
        "required": {"type": "array"},
        "excluded": {"type": "array"},
        "deferred_candidates": {"type": "array"}
      },
      "additionalProperties": false
    },
    "design_profile": {
      "type": "object",
      "properties": {
        "posture_ref": {"$ref": "#/$defs/posture_ref"},
        "behavior_budget": {"$ref": "#/$defs/behavior_budget"},
        "scope_provenance": {"type": "array"},
        "deferred_candidates": {"type": "array"},
        "input_refs": {"type": "array"}
      },
      "additionalProperties": true
    },
    "legacy_revision": {
      "type": "object",
      "required": ["revision", "scope", "status", "profile", "provider_selection", "options", "selected_option", "blocking_questions", "architecture_delta"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "scope": {"enum": ["root", "node"]},
        "node_id": {"type": ["string", "null"]},
        "status": {"enum": ["in_progress", "approved", "stale", "waived"]},
        "architecture_hash": {"type": ["string", "null"]},
        "profile": {"$ref": "#/$defs/design_profile"},
        "provider_selection": {"type": "object"},
        "provider_results": {"type": "array"},
        "options": {"type": "array"},
        "selected_option": {},
        "interfaces": {"type": "array"},
        "invariants": {"type": "array"},
        "failure_modes": {"type": "array"},
        "operational_model": {"type": "array"},
        "migration": {"type": "array"},
        "blocking_questions": {"type": "array"},
        "architecture_delta": {},
        "content_hash": {"$ref": "#/$defs/hash"},
        "design_hash": {"$ref": "#/$defs/hash"},
        "state_hash": {"$ref": "#/$defs/hash"},
        "approval": {}
      },
      "additionalProperties": true
    },
    "legacy_document": {
      "type": "object",
      "required": ["schema_version", "design_id", "current_revision", "revisions"],
      "properties": {
        "schema_version": {"const": "2.0"},
        "design_id": {"type": "string", "minLength": 1},
        "current_revision": {"type": "integer", "minimum": 1},
        "revisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/legacy_revision"}}
      },
      "additionalProperties": true
    },
    "posture_ref": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "posture_hash", "source_ref"],
          "properties": {
            "kind": {"enum": ["spike", "experiment", "reusable_internal", "production"]},
            "posture_hash": {"$ref": "#/$defs/hash"},
            "source_ref": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status"],
          "properties": {"status": {"const": "unknown_legacy"}},
          "additionalProperties": true
        },
        {"type": "null"}
      ]
    },
    "resolved_item": {
      "type": "object",
      "required": ["item_id", "type", "statement", "provenance", "status", "persistence"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "provenance": {"type": "array"},
        "status": {"enum": ["candidate", "approved", "verified", "rejected", "stale"]},
        "persistence": {"type": "object"}
      },
      "additionalProperties": true
    },
    "contract_claim": {
      "type": "object",
      "required": ["contract_id", "owner_ref", "envelope", "content_hash", "criticality", "verification_status", "evidence_refs", "consumer_refs"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "owner_ref": {"type": "string", "minLength": 1},
        "envelope": {},
        "content_hash": {"$ref": "#/$defs/hash"},
        "criticality": {"enum": ["noncritical", "critical"]},
        "verification_status": {"enum": ["candidate", "verified", "failed"]},
        "evidence_refs": {"type": "array"},
        "consumer_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "design_assessment": {
      "type": "object",
      "required": ["outcome", "subject_ref", "design_refs", "triggers", "rationale"],
      "properties": {
        "outcome": {"enum": ["covered_by", "inline", "thread_required"]},
        "subject_ref": {"type": ["string", "null"]},
        "design_refs": {"type": "array"},
        "triggers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "design_impact": {
      "type": "object",
      "required": ["impact_id", "classification", "source_ref", "affected_contract_ids", "affected_thread_ids", "evidence_refs", "rationale"],
      "properties": {
        "impact_id": {"type": "string", "minLength": 1},
        "classification": {"enum": ["no_contract_change", "contract_verified", "contract_changed", "architecture_changed", "posture_changed"]},
        "source_ref": {"type": "string", "minLength": 1},
        "affected_contract_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "affected_thread_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_refs": {"type": "array"},
        "rationale": {"type": "string"}
      },
      "additionalProperties": true
    },
    "ledger_revision": {
      "type": "object",
      "required": ["revision", "decision_status", "content_hash", "state_hash", "resolved_items", "contracts", "posture_ref", "provider_refs", "approval"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "decision_status": {"enum": ["in_progress", "approved", "stale", "waived"]},
        "content_hash": {"$ref": "#/$defs/hash"},
        "state_hash": {"$ref": "#/$defs/hash"},
        "resolved_items": {"type": "array", "items": {"$ref": "#/$defs/resolved_item"}},
        "contracts": {"type": "array", "items": {"$ref": "#/$defs/contract_claim"}},
        "assessments": {"type": "array", "items": {"$ref": "#/$defs/design_assessment"}},
        "posture_ref": {"$ref": "#/$defs/posture_ref"},
        "provider_refs": {"type": "array"},
        "approval": {}
      },
      "additionalProperties": true
    },
    "design_thread": {
      "type": "object",
      "required": ["thread_id", "kind", "subject_ref", "purpose", "parent_refs", "current_revision", "revisions", "thread_state_hash"],
      "properties": {
        "thread_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["root", "module", "relation", "task"]},
        "subject_ref": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "parent_refs": {"type": "array"},
        "current_revision": {"type": "integer", "minimum": 1},
        "revisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ledger_revision"}},
        "thread_state_hash": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": true
    },
    "ledger_document": {
      "type": "object",
      "required": ["schema_version", "design_id", "threads", "impacts", "document_state_hash"],
      "properties": {
        "schema_version": {"const": "2.1"},
        "design_id": {"type": "string", "minLength": 1},
        "threads": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/design_thread"}},
        "impacts": {"type": "array", "items": {"$ref": "#/$defs/design_impact"}},
        "document_state_hash": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/legacy_document"},
    {"$ref": "#/$defs/ledger_document"}
  ]
}
