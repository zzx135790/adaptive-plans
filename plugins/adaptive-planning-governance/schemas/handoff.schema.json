{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaptive-planning-governance/handoff.schema.json",
  "$defs": {
    "composition_contract": {
      "type": "object",
      "required": ["capability", "provider_id", "source_ref", "version_or_digest", "dependency_refs", "input_refs", "posture_ref", "mutability", "invocation", "persistence", "expected_outputs", "verification", "fallback"],
      "properties": {
        "capability": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "version_or_digest": {"type": "string", "minLength": 1},
        "dependency_refs": {"type": "array"},
        "input_refs": {"type": "array"},
        "posture_ref": {"type": ["object", "null"]},
        "mutability": {"type": "string", "minLength": 1},
        "invocation": {
          "type": "object",
          "required": ["policy", "state", "dependency_readiness"],
          "properties": {
            "policy": {"type": "string", "minLength": 1},
            "state": {"type": "string", "minLength": 1},
            "dependency_readiness": {"type": "string", "minLength": 1}
          }
        },
        "persistence": {
          "type": "object",
          "required": ["expectations", "state"],
          "properties": {
            "expectations": {"type": "string"},
            "state": {"type": "string", "minLength": 1}
          }
        },
        "expected_outputs": {"type": "array"},
        "verification": {
          "type": "object",
          "required": ["status", "evidence_refs"],
          "properties": {"status": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array"}}
        },
        "fallback": {}
      },
      "additionalProperties": true
    }
  },
  "type": "object",
  "required": ["schema_version", "source", "mode", "stage", "work_shape", "gates", "posture_ref", "behavior_budget", "scope_provenance", "deferred_candidates", "composition_contracts"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "source": {"type": "string"},
    "mode": {"enum": ["guide", "map", "plan", "direct"]},
    "stage": {"enum": ["intake", "guiding", "designing", "mapping", "leaf_planning", "executing", "validating", "complete"]},
    "work_shape": {"enum": ["undetermined", "direct", "plan", "map"]},
    "gates": {"type": "object"},
    "architecture_snapshot": {"type": ["object", "null"]},
    "design_refs": {"type": "array"},
    "posture_ref": {"type": ["object", "null"]},
    "behavior_budget": {
      "type": "object",
      "required": ["required", "excluded", "deferred_candidates"],
      "properties": {
        "required": {"type": "array"},
        "excluded": {"type": "array"},
        "deferred_candidates": {"type": "array"}
      },
      "additionalProperties": false
    },
    "scope_provenance": {"type": "array"},
    "deferred_candidates": {"type": "array"},
    "composition_contracts": {"type": "array", "items": {"$ref": "#/$defs/composition_contract"}},
    "summary": {"type": "string"},
    "artifacts": {"type": "array"},
    "questions": {"type": "array"},
    "assumptions": {"type": "array"},
    "findings": {"type": "array"},
    "decisions": {"type": "array"},
    "provider_results": {"type": "array"},
    "next_skill": {"type": ["string", "null"]},
    "extensions": {"type": "object"}
  },
  "additionalProperties": true
}
