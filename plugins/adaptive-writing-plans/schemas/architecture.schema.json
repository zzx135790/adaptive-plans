{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaptive-writing-plans/architecture.schema.json",
  "type": "object",
  "required": ["schema_version", "project_id", "revision", "status", "modules", "relations", "coverage"],
  "$defs": {
    "posture_ref": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "posture_hash", "source_ref"],
          "properties": {
            "kind": {"enum": ["spike", "experiment", "reusable_internal", "production"]},
            "posture_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "source_ref": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status"],
          "properties": {"status": {"const": "unknown_legacy"}},
          "additionalProperties": false
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "2.0"},
    "project_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "status": {"enum": ["proposed", "approved"]},
    "architecture_hash": {"type": "string"},
    "posture_default": {"$ref": "#/$defs/posture_ref"},
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "purpose", "non_goals", "owners", "owned_paths", "public_boundaries", "invariants", "dependencies", "required_concerns", "concerns", "source_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string"},
          "non_goals": {"type": "array", "items": {"type": "string"}},
          "owners": {"type": "array", "items": {"type": "string"}},
          "owned_paths": {"type": "array", "items": {"type": "string"}},
          "public_boundaries": {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "string", "minLength": 1},
                {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "path": {"type": "string", "minLength": 1},
                    "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                    "critical": {"type": "boolean"}
                  },
                  "anyOf": [{"required": ["path"]}, {"required": ["paths"]}],
                  "additionalProperties": true
                }
              ]
            }
          },
          "invariants": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "required_concerns": {"type": "array", "items": {"type": "string"}},
          "concerns": {"type": "object"},
          "source_refs": {
            "type": "array",
            "items": {"oneOf": [{"type": "string"}, {"type": "object"}]}
          },
          "contract_hash": {"type": "string"}
          ,
          "posture_default": {"$ref": "#/$defs/posture_ref"}
        },
        "additionalProperties": true
      }
    },
    "experimental_zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "objective", "owned_paths", "posture_ref", "source_refs", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "owned_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "posture_ref": {"$ref": "#/$defs/posture_ref"},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"oneOf": [{"type": "string"}, {"type": "object"}]}
          },
          "status": {"const": "active"}
        },
        "additionalProperties": true
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "from", "to", "interface_ref", "failure_propagation", "compatibility", "evidence_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["calls", "reads", "writes", "emits", "owns", "extends", "migrates"]},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "interface_ref": {"type": ["string", "null"]},
          "failure_propagation": {"type": "string"},
          "compatibility": {"type": "string"},
          "evidence_status": {"enum": ["confirmed", "inferred", "missing"]}
        },
        "additionalProperties": true
      }
    },
    "coverage": {
      "type": "object",
      "required": ["include_paths", "ignore_paths"],
      "properties": {
        "include_paths": {"type": "array", "items": {"type": "string"}},
        "ignore_paths": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "additionalProperties": true
}
