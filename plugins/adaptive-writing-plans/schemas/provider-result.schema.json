{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaptive-writing-plans/provider-result.schema.json",
  "$defs": {
    "composition_contract": {
      "type": "object",
      "required": ["capability", "provider_id", "source_ref", "version_or_digest", "dependency_refs", "input_refs", "posture_ref", "mutability", "invocation", "persistence", "expected_outputs", "verification", "fallback"],
      "properties": {
        "capability": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "version_or_digest": {"type": "string", "minLength": 1},
        "dependency_refs": {"type": "array"},
        "input_refs": {"type": "array"},
        "posture_ref": {"type": ["object", "null"]},
        "mutability": {"type": "string", "minLength": 1},
        "invocation": {"type": "object", "required": ["policy", "state", "dependency_readiness"]},
        "persistence": {"type": "object", "required": ["expectations", "state"]},
        "expected_outputs": {"type": "array"},
        "verification": {"type": "object", "required": ["status", "evidence_refs"]},
        "fallback": {}
      },
      "additionalProperties": true
    }
  },
  "type": "object",
  "required": ["schema_version", "provider_id", "capability", "status"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "provider_id": {"type": "string"},
    "capability": {"type": "string"},
    "status": {"enum": ["ok", "partial", "unavailable", "error", "unstructured"]},
    "questions": {"type": "array"},
    "assumptions": {"type": "array"},
    "findings": {"type": "array"},
    "options": {"type": "array"},
    "risks": {"type": "array"},
    "confidence": {"type": ["object", "null"]},
    "evidence": {"type": "array"},
    "observed_at": {"type": "string"},
    "raw": {},
    "raw_ref": {"type": ["string", "null"]},
    "composition_contract": {"oneOf": [{"$ref": "#/$defs/composition_contract"}, {"type": "null"}]},
    "lifecycle": {"type": "object"},
    "extensions": {"type": "object"}
  },
  "additionalProperties": true
}
