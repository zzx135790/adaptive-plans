{
  "name": "adaptive-writing-plans",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "description": "Portable adaptive planning protocol and local MCP server.",
  "bin": {
    "adaptive-plan": "./scripts/adaptive-plan.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "overview": "node scripts/overview.mjs",
    "migrate": "node scripts/migrate-plan.mjs",
    "posture:assess": "node scripts/posture-assess.mjs",
    "posture:check": "node scripts/posture-check.mjs",
    "posture:promote": "node scripts/posture-promote.mjs",
    "design:brief": "node scripts/design-brief.mjs",
    "architecture:check": "node scripts/architecture-check.mjs",
    "completion:check": "node scripts/completion-check.mjs",
    "validate": "node scripts/validate-plan.mjs --root .",
    "discover": "node scripts/discover-providers.mjs",
    "unavailable": "node scripts/mark-provider-unavailable.mjs",
    "doctor": "node scripts/doctor.mjs --root ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  }
}
